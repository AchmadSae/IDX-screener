# Copy this file to .env and adjust values.
NODE_ENV=development
PORT=50270
# Local dev uses a local Postgres; production should use a Supabase connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/idx_ui
# Optional: DeepSeek API key for AI-assisted analysis (rules-based predictions work without it).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# ZPI API key (https://zpi.web.id/dashboard/keys) — powers IDX fundamentals and market data.
ZPI_API_KEY=
# Hourly ingestion cron (IDX + forex) inside the Express process.
ENABLE_INGESTION_CRON=false
DATABASE_POOL_SIZE=10
